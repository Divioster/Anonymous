# Discord Application Bot Token (from Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (from Discord Developer Portal > General Information > Application ID)
CLIENT_ID=your_client_id_here

# Comma-separated list of Discord User IDs with Global Administrator & Bot Owner access
GLOBAL_ADMIN_IDS=123456789012345678

# SQLite database file path
DATABASE_PATH=./data/bot.sqlite

# Default avatar URL for anonymous users who haven't set a custom profile picture
DEFAULT_AVATAR_URL=https://cdn.discordapp.com/embed/avatars/0.png

